// PassengerDetailView placeholder 
import SwiftUI

struct PassengerDetailView: View {
    let passenger: Passenger
    @Environment(\.dismiss) private var dismiss
    
    var body: some View {
        NavigationView {
            ScrollView {
                VStack(alignment: .leading, spacing: 24) {
                    // Header
                    VStack(alignment: .leading, spacing: 12) {
                        HStack {
                            Text(passenger.name)
                                .font(.largeTitle)
                                .fontWeight(.bold)
                            
                            Spacer()
                            
                            if passenger.wheelchairFlag {
                                Image(systemName: "figure.roll")
                                    .font(.title)
                                    .foregroundColor(.blue)
                            }
                        }
                        
                        Text("Record ID: \(passenger.recid)")
                            .font(.caption)
                            .foregroundColor(.secondary)
                            .padding(.horizontal, 8)
                            .padding(.vertical, 4)
                            .background(Color(.systemGray5))
                            .cornerRadius(6)
                    }
                    
                    Divider()
                    
                    // Location Information
                    VStack(alignment: .leading, spacing: 16) {
                        Text("Location Details")
                            .font(.title2)
                            .fontWeight(.semibold)
                        
                        InfoRow(title: "Pickup Location", value: passenger.pickupLocation, icon: "location")
                        InfoRow(title: "Drop-off Location", value: passenger.dropoffLocation, icon: "location.fill")
                        InfoRow(title: "Scheduled Pickup", value: passenger.scheduledPickup, icon: "clock")
                        InfoRow(title: "Scheduled Drop-off", value: passenger.scheduledDropoff, icon: "clock.fill")
                    }
                    
                    Divider()
                    
                    // Medical Information
                    if let medicalNotes = passenger.medicalNotes, !medicalNotes.isEmpty {
                        VStack(alignment: .leading, spacing: 12) {
                            Text("Medical Notes")
                                .font(.title2)
                                .fontWeight(.semibold)
                            
                            HStack(alignment: .top, spacing: 12) {
                                Image(systemName: "exclamationmark.triangle.fill")
                                    .foregroundColor(.orange)
                                    .font(.title3)
                                
                                Text(medicalNotes)
                                    .font(.body)
                                    .multilineTextAlignment(.leading)
                            }
                            .padding(16)
                            .background(Color(.systemYellow).opacity(0.1))
                            .cornerRadius(12)
                            .overlay(
                                RoundedRectangle(cornerRadius: 12)
                                    .stroke(Color.orange.opacity(0.3), lineWidth: 1)
                            )
                        }
                        
                        Divider()
                    }
                    
                    // Contact Information
                    if let contactInfo = passenger.contactInfo, !contactInfo.isEmpty {
                        VStack(alignment: .leading, spacing: 12) {
                            Text("Contact Information")
                                .font(.title2)
                                .fontWeight(.semibold)
                            
                            HStack(spacing: 12) {
                                Image(systemName: "phone.fill")
                                    .foregroundColor(.blue)
                                    .font(.title3)
                                
                                Text(contactInfo)
                                    .font(.title3)
                                    .fontWeight(.medium)
                            }
                            .padding(16)
                            .background(Color(.systemBlue).opacity(0.1))
                            .cornerRadius(12)
                        }
                    }
                    
                    Spacer()
                }
                .padding(20)
            }
            .navigationTitle("Passenger Details")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .navigationBarTrailing) {
                    Button("Done") {
                        dismiss()
                    }
                    .font(.headline)
                }
            }
        }
        .navigationViewStyle(StackNavigationViewStyle())
    }
}

struct InfoRow: View {
    let title: String
    let value: String
    let icon: String
    
    var body: some View {
        HStack(alignment: .top, spacing: 12) {
            Image(systemName: icon)
                .foregroundColor(.blue)
                .font(.title3)
                .frame(width: 24)
            
            VStack(alignment: .leading, spacing: 4) {
                Text(title)
                    .font(.caption)
                    .fontWeight(.medium)
                    .foregroundColor(.secondary)
                    .textCase(.uppercase)
                Text(value)
                    .font(.body)
                    .fontWeight(.medium)
            }
            
            Spacer()
        }
        .padding(.vertical, 4)
    }
}

#Preview {
    PassengerDetailView(
        passenger: Passenger(
            recid: "001",
            name: "Maria Rodriguez",
            pickupLocation: "123 Grand Concourse, Bronx NY 10451",
            dropoffLocation: "456 Fordham Rd, Bronx NY 10458",
            scheduledPickup: "09:30 AM",
            scheduledDropoff: "10:15 AM",
            status: .pending,
            medicalNotes: "Wheelchair accessible required. Patient has mobility issues.",
            contactInfo: "(555) 123-4567",
            wheelchairFlag: true
        )
    )
}
